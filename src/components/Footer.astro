---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<style>
.footer {
  background-color: #333333;
  color: white;
  width: 100%;  
  min-height: 15vh;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  padding: 30px 10px 10px;
  box-sizing: border-box;
  gap: 20px;
}


#main{
  display: flex;
  flex-direction: row;
  width: 100%;
  margin: 0px;
  padding: 0%;
  gap: 20px;
}

#main div{
  margin: auto;
}

#slogan{
  width: 100%;
  display: flex;
  flex-direction: column;
  margin: auto;
  padding: 0;
}
#slogan h2, #slogan p{
  margin: auto;
}

.footer-map {
  width: 100%;
  max-width: 1100px;
  height: 160px;
  margin: 0;
}

.footer-map iframe {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}


.footer-horario ul {
  list-style: none;
  padding-left: 40px;
  margin: 0;
  margin-bottom: 0px;
}

.footer-horario{
  width: 20vw;
  display: flex;
  flex-direction: column;
}

.footer-contacto{
  width: 20vw;
  display: flex;
  flex-direction: column;
  align-items: center;

}

.footer-horario h2{
  text-align: left;
  padding: 0%;
  margin: 0;
  padding-left: 40px;
}

.footer a {
  color: white;
  text-align: center;
  text-decoration: none;
  font-size: smaller;
}

.footer a:hover {
  color: yellow;
}

@media (max-width: 768px) {
  #global{
    width: 90vw;
  }
  .footer {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px 16px 40px;
    gap: 15px;
  }

  

  #main{
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 18px;
  }

  .footer-horario h2{
    text-align: center;
    margin: 0;
    padding: 0;
  }
  .footer-horario ul{
    text-align: center;
    margin: 8px auto 0;
    padding: 0;
    width: 100%;
  }

  .footer-horario, .footer-contacto, .footer-map {
    width: 100%;
    margin: auto;
  }

  .footer-map {
    order: 2;
    height: 180px;
    max-width: 760px;
  }

  .footer h2, .footer h3 {
    margin: 25px 0 5px 0;
    font-size: 1.5rem;
  }

  .footer p, .footer ul {
    margin: 5px 0;
  }
  
  .footer-map center p {
    margin-top: 15px;
    padding: 0 6px;
    line-height: 1.4;
  }
}

</style>

<footer class="footer">


  <div id="global">
    <section id="slogan">
      <h2>{t('footer_slogan_title')}</h2>
      <p>{t('footer_slogan_subtitle')}</p>
    </section>
    <section id="main">
      <div class="footer-horario">
        <h2>{t('footer_main_title')}</h2>

        <ul>
          <li>
            <strong>{t('footer_main_week_days')}:</strong> 
          </li>
          <li>09:00 – 18:00</li>
          <br>
          <li>
            <strong>{t('footer_main_weekend_days')}:</strong> 
          </li>
          <li>{t('footer_main_weekend_days_state')}</li>
        </ul>
      </div>
    
      <div class="footer-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12168.70617650497!2d-3.8553517!3d40.316239249999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd418c24d578dbb5%3A0xd2923868792d2c42!2sMudanzas%20Pilas!5e0!3m2!1ses!2ses!4v1772617679705!5m2!1ses!2ses" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="ubicacion"></iframe>
        <center><p><a href="">{t('footer_main_legal')}</a> | <a href="">{t("footer_main_policy")}</a></p></center>
      </div>
    
      <div class="footer-contacto">
        <div>
          <h2>{t('footer_main_contact_title')}</h2>
          <p>{t('footer_main_contact_street')}.</p>
          <p>{t('footer_main_contact_phone')}.</p>
          <p>{t('footer_main_contact_fax')}.</p>
        </div>
      </div>
    </section>
  </div>


</footer>