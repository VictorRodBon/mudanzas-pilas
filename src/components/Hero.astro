---
const { alt, lang: langProp } = Astro.props;

import { getLangFromUrl, useTranslations } from '../i18n/utils';

const urlLang = getLangFromUrl(Astro.url);
const lang = langProp || urlLang;
const t = useTranslations(lang);
---

<section class="hero" id="hero" aria-label="Hero" data-title="Inicio">
  <div class="hero__inner">
    <h1 class="hero__title">{t("hero_title")}</h1>
    <p class="hero__tagline">{t("hero_tagline")}</p>
    <p class="hero__sub">{t("hero_sub")}.</p>
  </div>
</section>

<style>
  .hero {
    height: clamp(300px, 100vh, calc(100vh - 105px));
    width: calc(100% - 48);
    background-image: url("/img/fondo.svg");
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    background-repeat: no-repeat;
    background-size: cover;
    scroll-margin-top: 105px;
  }
  .hero__inner {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.05;
    color: #0f2e5f;
    letter-spacing: 0.5px;
  }

  .hero__tagline {
    margin: 14px 0 0;
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 700;
    color: #163d7a;
  }

  .hero__sub {
    margin: 10px 0 0;
    font-size: clamp(15px, 1.7vw, 18px);
    color: #2f2f2f;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }
</style>
