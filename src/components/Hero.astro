---
const img = Astro.props.img ?? "/img/hero.jfif";
const alt = Astro.props.alt ?? "Mudanzas Pila";
---

<section class="hero" aria-label="Hero">
  <div class="hero__inner">
    <h1 class="hero__title">Mudanzas Pilas</h1>
    <p class="hero__tagline">Mudanzas rápidas, cuidadas y al mejor precio</p>
    <p class="hero__sub">Nos encargamos de todo. Tú solo estrena casa.</p>
  </div>
</section>

<style>
  .hero {
  height: clamp(300px, 55vh, 520px);
  width: calc(100% - 24px);
  background: linear-gradient(135deg, #f3f7ff 0%, #f6ead8 70%, #fff7ee 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
  }
  .hero__inner{
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
  text-align: center;
}

.hero__title{
  margin: 0;
  font-size: clamp(38px, 5vw, 64px);
  line-height: 1.05;
  color: #0f2e5f; 
  letter-spacing: 0.5px;
  }

.hero__tagline{
  margin: 14px 0 0;
  font-size: clamp(18px, 2.2vw, 26px);
  font-weight: 700;
  color: #163d7a;
}

.hero__sub{
  margin: 10px 0 0;
  font-size: clamp(15px, 1.7vw, 18px);
  color: #2f2f2f;
}

  .hero__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }
</style>