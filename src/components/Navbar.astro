---
import LanguagePicker from './LanguagePicker.astro';
const { alt, lang: langProp } = Astro.props;

import { getLangFromUrl, useTranslations } from '../i18n/utils';

const urlLang = getLangFromUrl(Astro.url);
const lang = langProp || urlLang;
const t = useTranslations(lang);

const prefix = lang === 'es' ? '' : `/${lang}`;
---
<nav class="navbar">
  <div class="logo">
    <img src="/img/logo.png" alt="Logo" />
  </div>

  <button class="menu-toggle" id="menu-btn" aria-label="Abrir menú">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <ul class="nav-links" id="nav-links">
    <li><a href={`${prefix}/#hero`} data-title="Inicio">{t('link_1')}</a></li>
    <li><a href={`${prefix}/#servicios`} data-title="Servicios">{t('link_2')}</a></li>
    <li><a href={`${prefix}/#presupuesto`} data-title="Contacto">{t('link_3')}</a></li>
    <li><a href={`${prefix}/about`}>{t('link_4')}</a></li>
    <li><LanguagePicker  /></li>
  </ul>
</nav>

<script>

  const w = window as Window & { __mudanzasNavbarBound?: boolean };
  if (!w.__mudanzasNavbarBound) {
    // Evita registrar el mismo listener más de una vez (por ejemplo, tras navegar).
    w.__mudanzasNavbarBound = true;

    // Cierra el menú dejando el DOM en estado "cerrado".
    const closeMenu = (btn: HTMLElement, links: HTMLElement) => {
      links.classList.remove("is-open");
      btn.classList.remove("active");
    };

    document.addEventListener("click", (e) => {
      if (!(e.target instanceof Node)) return;

      const btn = document.getElementById("menu-btn");
      const links = document.getElementById("nav-links");
      // Si el navbar no está presente en esta vista, no hay nada que hacer.
      if (!btn || !links) return;

      // 1) Click en el botón: alterna abrir/cerrar (toggle).
      if (btn.contains(e.target)) {
        links.classList.toggle("is-open");
        btn.classList.toggle("active");
        return;
      }

      // 2) Click dentro del menú: si fue en un enlace, cierra (para UX en móvil).
      if (links.contains(e.target)) {
        const el = e.target instanceof Element ? e.target : null;
        if (el?.closest("a")) closeMenu(btn, links);
        return;
      }

      // 3) Click fuera del botón y del menú: cierra.
      closeMenu(btn, links);
    });
  }
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: #333333;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 105px;
    width: 100%;
    padding: 0 5%;
    box-sizing: border-box;
  }

  .logo img {
    max-height: 80px;
    width: auto;
    display: block;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 10px;
  }

  .nav-links li a {
    display: block;
    color: white;
    font-family: "Gill Sans", sans-serif;
    font-weight: bold;
    font-size: 18px;
    padding: 15px 25px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 4px;
  }

  .nav-links li a:hover {
    background-color: white;
    color: black;
    transform: translateY(-3px);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    transition: 0.3s;
  }

  .bar {
    width: 30px;
    height: 3px;
    background-color: white;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }
    
    .navbar {
      height: 75px;
    }
    
    .logo img {
      max-height: 55px;
      width: auto;
      display: block;
    }

    .nav-links {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 75px;
      left: 0;
      width: 100%;
      background-color: #333333;
      gap: 0;

      max-height: 0;
      overflow: hidden;
      transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-links.is-open {
      max-height: 400px;
      border-top: 1px solid #444;
      box-shadow: 0 10px 15px rgba(0, 0, 0, 0.3);
    }

    .nav-links li {
      width: 100%;
      opacity: 0;
      transform: translateY(-20px);
      transition: 0.4s ease;
    }

    .nav-links.is-open li {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.2s;
    }

    .nav-links li a {
      padding: 20px;
      border-bottom: 1px solid #444;
      border-radius: 0;
    }

    .nav-links li a:hover {
      transform: none;
      padding-left: 35px;
    }
    .bar {
      width: 30px;
      height: 3px;
      background-color: white;
      border-radius: 2px;
      transition: 0.4s;
    }

    .menu-toggle.active .bar:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }
    .menu-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle.active .bar:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }
  }
</style>
