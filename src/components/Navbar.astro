<nav class="navbar">
  <div class="logo">
    <img src="/img/logo.png" alt="Logo" />
  </div>

  <button class="menu-toggle" id="menu-btn" aria-label="Abrir menú">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <ul class="nav-links" id="nav-links">
    <li><a href="/#hero" data-title="Inicio">INICIO</a></li>
    <li><a href="/#servicios" data-title="Servicios">SERVICIOS</a></li>
    <li><a href="/#presupuesto" data-title="Contacto">CONTACTO</a></li>
    <li><a href="/about">¿QUIÉNES SOMOS?</a></li>
  </ul>
</nav>

<script>
  /**
   * Inicializa la interacción del Navbar en móvil.
   *
   * Importante: el proyecto usa `ClientRouter` (astro:transitions), así que al navegar
   * entre páginas el DOM se reemplaza sin recargar el sitio. Por eso necesitamos
   * re-enganchar los listeners en cada `astro:page-load`.
   */
  function initMobileMenu() {
    const btn = document.getElementById("menu-btn");
    const links = document.getElementById("nav-links");

    // Si por algún motivo el navbar no está en la página, no hacemos nada.
    if (!btn || !links) return;

    /**
     * Evita duplicar listeners entre navegaciones.
     * Guardamos un `AbortController` en `window` para poder "desregistrar" todos los
     * handlers anteriores antes de volver a inicializar.
     */
    const ww = window as Window & {
      __mudanzasMobileMenuAbortController?: AbortController;
    };
    const prev = ww.__mudanzasMobileMenuAbortController;
    if (prev) {
      prev.abort();
    }
    const controller = new AbortController();
    ww.__mudanzasMobileMenuAbortController = controller;
    const { signal } = controller;

    // Abre/cierra el menú (clase `is-open`) y anima el botón hamburguesa (`active`).
    btn.addEventListener(
      "click",
      () => {
        links.classList.toggle("is-open");
        btn.classList.toggle("active");
      },
      { signal }
    );

    // Al pulsar cualquier enlace del menú, se cierra el desplegable.
    links.querySelectorAll("a").forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          links.classList.remove("is-open");
          btn.classList.remove("active");
        },
        { signal }
      );
    });

    // Click fuera del menú/botón: cierra el desplegable para mejorar UX en móvil.
    document.addEventListener(
      "click",
      (e) => {
        if (!(e.target instanceof Node)) return;

        const clickDentroMenu = links.contains(e.target);
        const clickEnBoton = btn.contains(e.target);

        if (!clickDentroMenu && !clickEnBoton) {
          links.classList.remove("is-open");
          btn.classList.remove("active");
        }
      },
      { signal }
    );
  }

  // Carga inicial (primer render del documento).
  document.addEventListener("DOMContentLoaded", initMobileMenu);
  // Navegación cliente (Astro View Transitions / ClientRouter).
  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: #333333;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 105px;
    width: 100%;
    padding: 0 5%;
    box-sizing: border-box;
  }

  .logo img {
    max-height: 80px;
    width: auto;
    display: block;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 10px;
  }

  .nav-links li a {
    display: block;
    color: white;
    font-family: "Gill Sans", sans-serif;
    font-weight: bold;
    font-size: 18px;
    padding: 15px 25px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 4px;
  }

  .nav-links li a:hover {
    background-color: white;
    color: black;
    transform: translateY(-3px);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    transition: 0.3s;
  }

  .bar {
    width: 30px;
    height: 3px;
    background-color: white;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-links {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 105px;
      top: 105px;
      left: 0;
      width: 100%;
      background-color: #333333;
      gap: 0;

      max-height: 0;
      overflow: hidden;
      transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-links.is-open {
      max-height: 400px;
      border-top: 1px solid #444;
      box-shadow: 0 10px 15px rgba(0, 0, 0, 0.3);
    }

    .nav-links li {
      width: 100%;
      opacity: 0;
      transform: translateY(-20px);
      transition: 0.4s ease;
    }

    .nav-links.is-open li {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.2s;
    }

    .nav-links li a {
      padding: 20px;
      border-bottom: 1px solid #444;
      border-radius: 0;
    }

    .nav-links li a:hover {
      transform: none;
      padding-left: 35px;
    }
    .bar {
      width: 30px;
      height: 3px;
      background-color: white;
      border-radius: 2px;
      transition: 0.4s;
    }

    .menu-toggle.active .bar:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }
    .menu-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle.active .bar:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }
  }
</style>
