---
const { nombre, img } = Astro.props;

import Modal from "./Modal.astro";
let open = false;
---

<div class="servicio">
  <h3>{nombre}</h3>

  <img src={img} alt={nombre} loading="eager" />

  <button class="open-modal">Más información</button>

  <Modal open={open}>
    <h3>{nombre}</h3>
    <slot />
  </Modal>
  <script is:inline>
    {
      const root = document.currentScript.closest(".servicio");
      const openBtn = root.querySelector(".open-modal");
      const modal = root.querySelector(".modal");
      const closeBtn = modal.querySelector(".close-modal");

      // Abrir modal
      openBtn.addEventListener("click", () => modal.classList.add("show"));

      // Cerrar con botón
      closeBtn.addEventListener("click", () => modal.classList.remove("show"));

      // Cerrar al hacer clic fuera
      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          modal.classList.remove("show");
        }
      });
    }
  </script>
</div>

<style>
  .servicio {
    background-color: #f2f2f2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px;
    border: 3px solid #1f4ea6;
    border-radius: 10px;
    width: 18vw;
    max-width: 1024px;
    min-width: 300px;
  }

  h3 {
    margin: 0px;
    color: #1f4ea6;
    font-size: 2rem;
    text-align: center;
    width: auto;
  }
  img {
    width: 50%;
    margin: 10% auto 10%;
  }

  .open-modal {
    border: none;
    height: 30px;
    border-radius: 5px;
    background-color: #1f4ea6;
    color: #f2f2f2;
    transition: 0.2s ease-in-out;
    font-size: 1.0625rem;
  }
  .open-modal:hover {
    background-color: #132e62;
  }
</style>
