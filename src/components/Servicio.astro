---
import { useTranslations } from '../i18n/utils';
const { nombre, img, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

import Modal from "./Modal.astro";
let open = false;
---

<div class="servicio">
  <h3>{nombre}</h3>

  <img src={img} alt={nombre} loading="eager" />

  <button class="open-modal">{t('servicios_more_info')}</button>

  <Modal open={open} lang={lang}>
    <h3>{nombre}</h3>
    <slot />
  </Modal>
<script>
  function inicializarModales() {
    const servicios = document.querySelectorAll('.servicio');
    servicios.forEach((root) => {
      const openBtn = root.querySelector('.open-modal');
      const modal = root.querySelector('.modal');
      const closeBtn = modal ? modal.querySelector('.close-modal') : null;

      if (!openBtn || !modal || !closeBtn) return;

      const newOpenBtn = openBtn.cloneNode(true);
      openBtn.replaceWith(newOpenBtn);

      const newCloseBtn = closeBtn.cloneNode(true);
      closeBtn.replaceWith(newCloseBtn);

      newOpenBtn.addEventListener('click', () => modal.classList.add('show'));

      newCloseBtn.addEventListener('click', () => modal.classList.remove('show'));

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.remove('show');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', inicializarModales);
</script>
</div>

<style>
  .servicio {
    background-color: #f2f2f2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px;
    border: 3px solid #0f2e5f;
    border-radius: 10px;
    width: 18vw;
    max-width: 1024px;
    min-width: 300px;
  }

  h3 {
    margin: 0px;
    color: #0f2e5f;
    font-size: 2rem;
    text-align: center;
    width: auto;
  }
  img {
    width: 50%;
    margin: 10% auto 10%;
  }

  .open-modal {
    border: none;
    height: 30px;
    border-radius: 5px;
    background-color: #1f4ea6;
    color: #f2f2f2;
    transition: 0.2s ease-in-out;
    font-size: 1.0625rem;
  }
  .open-modal:hover {
    background-color: #132e62;
  }
</style>
