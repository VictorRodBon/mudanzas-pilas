---
import servicios from "../assets/servicios.json"
import Servicio from "./Servicio.astro"

---
<h2>SERVICIOS</h2>

<div class="servicios">
  {
    Object.values(servicios).map((s: any)=>(
      <Servicio nombre={s.nombre}>
        
        {
        
          Object.values(s.parrafos).map((p: any)=>(
            <p>{p}</p>
          ))
        }
        <i class='fa-solid fa-box-archive'></i>
      </Servicio>
    ))
  }
</div>

<style>
  .servicios {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
    gap: 5vw;
    width:100%
  }

  h2 {
    color: #1f4ea6;
    font-size: 3rem;
  }

  p {
    font-size: 1.25rem;
  }
</style>
