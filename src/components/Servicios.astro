---
import servicios from "../assets/servicios.json";
import Servicio from "./Servicio.astro";
---

<section id="servicios" data-title="Servicios">
  <h2>SERVICIOS</h2>
  <div id="serviciosContent">
    {
      Object.values(servicios).map((s: any) => (
        <Servicio nombre={s.nombre} img={s.img}>
          {Object.values(s.parrafos).map((p: any) => (
            <p>{p}</p>
          ))}
          <i class="fa-solid fa-box-archive" />
        </Servicio>
      ))
    }
  </div>
</section>

<style>
  #servicios {
    scroll-margin-top: 100px;
    margin: 0 10%;
    padding: 5% 0;
    min-height: calc(100vh - 105px);
  }

  #serviciosContent {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
    gap: 5vw;
    width: 100%;
  }

  h2 {
    color: #1f4ea6;
    font-size: 3rem;
    padding: 0%;
    text-align: center;
  }

  p {
    font-size: 1.25rem;
    color: #1f2937;
  }

  @media (max-width: 768px) {
    p{
      font-size: 1rem;
    }
  }

  
</style>
