---
import Servicio from "./Servicio.astro";
import { useTranslations, getLangFromUrl } from "../i18n/utils";

const { lang: langProp } = Astro.props;
const urlLang = getLangFromUrl(Astro.url);
const lang = langProp || urlLang;
const t = useTranslations(lang);
const servicios = t('servicios') as any;
---

<section id="servicios" data-title={t('servicios_title')}>
  <h2>{t('servicios_title')}</h2>
  <div id="serviciosContent">
    {
      Object.values(servicios).map((s: any) => (
        <Servicio nombre={s.nombre} img={s.img} lang={lang}>
          {Object.values(s.parrafos).map((p: any) => (
            <p>{p}</p>
          ))}
          <i class="fa-solid fa-box-archive" />
        </Servicio>
      ))
    }
  </div>
</section>

<style>
  #servicios {
    scroll-margin-top: 100px;
    margin: 0 10%;
    padding: 5% 0;
    min-height: calc(100vh - 105px);
  }

  #serviciosContent {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
    gap: 5vw;
    width: 100%;
  }

  h2 {
    color: #0f2e5f;
    font-size: 3rem;
    padding: 0%;
    text-align: center;
  }

  p {
    font-size: 1.25rem;
    color: #1f2937;
  }

  @media (max-width: 768px) {
    p{
      font-size: 1rem;
    }
  }

  
</style>
