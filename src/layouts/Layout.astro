---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import { ClientRouter } from "astro:transitions";

import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	canonicalURL?: string;
	ogImageUrl?: string;
	lang?: 'es' | 'en';
}

const {
	title,
	description,
	canonicalURL,
	ogImageUrl,
	lang: langProp,
} = Astro.props;

const lang = langProp ?? getLangFromUrl(Astro.url);
const brandName = lang === 'en' ? 'Pilas Removals' : 'Mudanzas Pilas';
const pageTitle = title ?? brandName;
const pageDescription = description ?? (lang === 'en'
    ? 'Professional local and national moving services in Madrid. Request a quote from the Pilas Removals team.'
    : 'Servicios profesionales de mudanzas locales y nacionales en Madrid. Pide presupuesto al equipo de Mudanzas Pilas.');
const pageCanonicalURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const pageOgImageUrl = ogImageUrl ?? new URL('/img/logo.png', Astro.site ?? Astro.url).href;
const imageAlt = lang === 'en' ? 'Pilas Removals logo' : 'Logotipo de Mudanzas Pilas';
---

<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Estándar -->
	<title>{pageTitle}</title>
	<meta name="description" content={pageDescription} />
	<link rel="canonical" href={pageCanonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
	<meta property="og:url" content={pageCanonicalURL} />
	<meta property="og:title" content={pageTitle} />
	<meta property="og:description" content={pageDescription} />
	<meta property="og:image" content={pageOgImageUrl} />
	<meta property="og:image:type" content="image/png" />
	<meta property="og:image:width" content="1066" />
	<meta property="og:image:height" content="389" />
	<meta property="og:image:alt" content={imageAlt} />

    <!-- Tarjeta específica para X (Twitter) -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:url" content={pageCanonicalURL} />
	<meta name="twitter:title" content={pageTitle} />
	<meta name="twitter:description" content={pageDescription} />
	<meta name="twitter:image" content={pageOgImageUrl} />
	<meta name="twitter:image:alt" content={imageAlt} />

    <ClientRouter />
</head>
	<body>
		<Navbar/>
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		background-color: #f2f0ef;
		margin: 0;
		width: 100%;
		font-family:
			Avenir, "Helvetica Neue", "Lato", "Segoe UI", Helvetica, Arial,
			sans-serif;
		scroll-behavior: smooth;
	}
</style>

<!-- Pasamos la variable brandName de Astro al cliente usando define:vars -->
<script is:inline define:vars={{ brandName }}>
	function initSectionObserver() {
		const sections = document.querySelectorAll("section[data-title]");
	
		const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
			if (entry.isIntersecting) {
				const newTitle = entry.target.dataset.title;
				// Ahora respeta la marca internacionalizada recibida de Astro
				document.title = `${brandName} | ${newTitle}`;
			}
			});
		},
		{
			threshold: 0.5, 
		}
		);
	
		sections.forEach((sec) => observer.observe(sec));
	}
	document.addEventListener("DOMContentLoaded", initSectionObserver);
	document.addEventListener("astro:page-load", initSectionObserver);
</script>
