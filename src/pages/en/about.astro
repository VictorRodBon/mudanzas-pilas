---
import Layout from "../../layouts/Layout.astro";
import Servicio from "../../components/Servicio.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const elegirnos = t('elegirnos') as any;
---

<Layout
  lang={lang}
  title="About Us | Pilas Removals"
  description="Meet Pilas Removals, specialists in local and national moves with a safe, efficient and hassle-free service."
>
  <section data-title={t('about_title')} id="principal">
    <main>
      <section>
        <h2>{t('about_title')}</h2>
        <p>
          {t('about_who_we_are')}
        </p>
      </section>
  
      <section>
        <h2>{t('about_history_title')}</h2>
        <p>
          {t('about_history_p1')}
        </p>
  
        <p>{t('about_today_we_have')}</p>
        <ul>
          <li>{t('about_vehicle_list')}</li>
          <li>{t('about_staff_list')}</li>
          <li>{t('about_materials_list')}</li>
          <li>{t('about_insurance_list')}</li>
        </ul>
      </section>
  
      <section>
        <h2>{t('about_way_working_title')}</h2>
        <p>{t('about_way_working_p1')}</p>
  
        <p>{t('about_way_working_p2')}</p>
  
        <ul>
          <li>{t('about_nearness_item')}</li>
          <li>{t('about_transparency_item')}</li>
          <li>{t('about_care_item')}</li>
          <li>{t('about_efficiency_item')}</li>
        </ul>
      </section>
  
      <section>
        <h2>{t('about_team_title')}</h2>
        <p>
          {t('about_team_p1')}
        </p>
        <ul>
          <li>{t('about_team_item_1')}</li>
          <li>{t('about_team_item_2')}</li>
          <li>{t('about_team_item_3')}</li>
          <li>{t('about_team_item_4')}</li>
          <li>{t('about_team_item_5')}</li>
        </ul>
        <p>
          {t('about_team_p2')}
        </p>
      </section>
  
      <section id="elegirnos">
        <h2>{t('elegirnos_title')}</h2>
        <div id="elegirnosContent">
          {
            Object.values(elegirnos).map((s: any) => (
              <Servicio nombre={s.nombre} img={s.img} lang={lang}>
                {Object.values(s.parrafos).map((p: any) => (
                  <p>{p}</p>
                ))}
                <i class="fa-solid fa-box-archive" />
              </Servicio>
            ))
          }
        </div>
      </section>
  
      <section>
        <h2>{t('about_help_title')}</h2>
        <p>
          {t('about_help_p1')}
        </p>
        <p>{t('about_help_p2')}</p>
      </section>
    </main>
  </section>
</Layout>

<style>
  section {
    width: 75%;
    margin: auto;
  }
  main {
    width: 100%;
    background-color: #f7f7f7;
    padding-top: 10px;
  }

  .titulo {
    color: #1f4ea6;
    font-size: 3rem;
    padding: 0%;
    text-align: center;
    font-weight: bold;
  }

  #elegirnos {
    scroll-margin-top: 100px;
    margin: 0 10%;
    padding: 0;
    min-height: calc(100vh - 105px);
    margin: auto;
    width: 100%;
    padding-bottom: 7vh;
  }

  #elegirnos>h2{
    text-align: center;
  }

  #elegirnosContent {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
    gap: 5vw;
    width: 100%;
    margin: auto;
    margin-top: 2vh;
  }

  h2 {
    color: #0f2e5f;
    font-size: 3rem;
    padding: 0%;
    text-align: left;
    margin: 0;
  }

  p:not(#elegirnosContent p) {
    font-size: 1.25rem;
    color: #1f2937;
    padding: 0px;
    margin: 0%;
  }

  main>section{
    padding-bottom: 5vh;
  }

  main>section:last-child{
    padding-bottom: 10vh;
  }

  ul{
    margin: 0%;
  }


  @media (max-width: 768px) {
    section {
      width: 90%;
    }

    #elegirnos {
      margin: 0;
    }

    h2, .titulo {
      font-size: 2rem;
    }

    p {
      font-size: 1rem;
    }
  }

  
</style>