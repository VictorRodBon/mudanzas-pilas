---
import Layout from '../layouts/Layout.astro';
import Main from '../components/Main.astro';

import Hero from '../components/Hero.astro';
import Presupuesto from '../components/Presupuesto.astro';

import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<Layout
	lang={lang}
	title="Mudanzas Pilas | Mudanzas en Madrid"
	description="Mudanzas locales y nacionales en Madrid. Embalaje, transporte y montaje con un equipo profesional. Pide tu presupuesto."
>
	<Hero lang={lang}/>
	<Main lang={lang}/>
	<Presupuesto lang={lang}/>
</Layout>
